# Alpaca API Credentials (Paper or Live)
# Get your free paper trading keys at https://app.alpaca.markets
APCA_API_KEY_ID=your_alpaca_key_id_here
APCA_API_SECRET_KEY=your_alpaca_secret_key_here
APCA_PAPER=True

# AI Assistant API Keys (Google Gemini / Featherless AI / Anthropic)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

FEATHERLESS_API_KEY=your_featherless_api_key_here
FEATHERLESS_MODEL=Qwen/Qwen2.5-72B-Instruct

# Optional: Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here
